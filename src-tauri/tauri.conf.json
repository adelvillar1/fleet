{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fleet",
  "version": "0.3.0-beta",
  "identifier": "dev.fleet.shell",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fleet",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../services": "services"
    }
  }
}
