{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fleet",
  "version": "0.6.24",
  "identifier": "dev.fleet.shell",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fleet",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../services": "services"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMDZCNDJFOUJFNTIzNDIKUldSQ0krV2JMclFHbnRCMWJFSHNLL3ErK2pYZUVoTlIzUTNvaTlQU1RROFVQd1VFRXlrRVBvVDkK",
      "endpoints": [
        "https://github.com/adelvillar1/fleet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
