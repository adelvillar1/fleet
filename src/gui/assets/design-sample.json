   "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Draft \u2014 Ember &amp; Oak pricing</title><style>:root{--bg:#f7f3ec;--ink:#241c14;--muted:#6b5d4d;--accent:#9a5b32;--radius:6px;--space-unit:8px;--font-scale:1}body{margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,'Times New Roman',serif;line-height:1.5}.wrap{max-width:960px;margin:0 auto;padding:calc(6*var(--space-unit)) calc(4*var(--space-unit))}header{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:calc(4*var(--space-unit));border-bottom:1px solid #e4dbcb}nav a{color:var(--muted);text-decoration:none;font-family:system-ui,sans-serif;font-size:.85rem;margin-left:calc(2.5*var(--space-unit))}h1{font-size:calc(var(--font-scale)*2.4rem);line-height:1.1;margin:.8em 0 .3em}.plans{display:flex;gap:calc(4*var(--space-unit));margin-top:calc(5*var(--space-unit));align-items:stretch}.plan{flex:1;border:1px solid #e4dbcb;border-radius:var(--radius);padding:calc(3*var(--space-unit));background:#fffdf8;display:flex;flex-direction:column}.plan.featured{border-color:var(--accent);border-width:2px}.plan h2{font-size:1.05rem;margin:0 0 .3em}.price{font-size:calc(var(--font-scale)*2rem);font-weight:bold;margin:.2em 0}.price span{font-size:.85rem;color:var(--muted);font-family:system-ui,sans-serif;font-weight:normal}.plan ul{list-style:none;padding:0;margin:calc(2*var(--space-unit)) 0;font-family:system-ui,sans-serif;font-size:.85rem;color:var(--muted)}.plan li{padding:.35em 0;border-bottom:1px dashed #eee5d4}button{margin-top:auto;background:var(--accent);color:#fff;border:0;padding:11px 20px;border-radius:var(--radius);font-family:system-ui,sans-serif;font-weight:600;cursor:pointer}.note{font-family:system-ui,sans-serif;font-size:.7rem;color:#b3a68f;letter-spacing:.08em;text-transform:uppercase;margin-top:calc(6*var(--space-unit))}@media(max-width:640px){.plans{flex-direction:column}}</style></head><body><div class=\"wrap\"><header><strong>Ember &amp; Oak</strong><nav><a href=\"#\">Beans</a><a href=\"#\">Subscriptions</a><a href=\"#\">Visit</a></nav></header><main><h1>Simple subscriptions.</h1><div class=\"plans\"><div class=\"plan\"><h2>Solo</h2><div class=\"price\">$14<span>/mo</span></div><ul><li>One 250g bag monthly</li><li>Roaster's choice</li><li>Free shipping</li></ul><button>Choose Solo</button></div><div class=\"plan featured\"><h2>Household</h2><div class=\"price\">$26<span>/mo</span></div><ul><li>Two 250g bags monthly</li><li>Pick your origins</li><li>Free shipping</li><li>Early access to experiments</li></ul><button>Choose Household</button></div><div class=\"plan\"><h2>Office</h2><div class=\"price\">$90<span>/mo</span></div><ul><li>Eight bags monthly</li><li>Pick your origins</li><li>Invoice billing</li></ul><button>Choose Office</button></div></div><p class=\"note\">Draft sample content</p></main></div></body></html>",
