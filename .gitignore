/target

# Vendored Python lane cores: bytecode is regenerated on every lane run
__pycache__/

# The generated embedding index beside the fact tree it derives from —
# rebuilt on load, like __pycache__
/memories/.recall-index.json

# Orphans from the atomic rewrites: the index and the recall-count bump
# each write through a unique `.<pid>.<n>.tmp` and rename, so a crash
# mid-write can leave one behind. A leftover temp is never a fact.
/memories/*.tmp

# KI-062's per-fact write locks: a sibling `.lock` beside each fact,
# opened for the whole read-modify-write so a consolidation pass and a
# live recall-count bump cannot lose an update. It is deliberately left
# on disk — unlinking a flocked file another process holds is a race —
# so it is ignored rather than cleaned up. The loader reads `*.md` only,
# so a lock never enters recall.
/memories/*.lock

# The corpus-refresh jobs' state-sync facts: one snapshot per project per
# scheduled window, written through `remember` by the cron lane and
# superseded by the next window's. Runtime state like the index above —
# the run is the record and the fact is its stamp — so they stay on disk
# (recall reads them) but out of the tree. Both rules key on the shape
# the writer stamps, a date or an item count, never on the word: a
# durable fact about the corpus is named for its claim and stays tracked.
/memories/*-corpus*-20[0-9][0-9]-*.md
/memories/*-corpus-*-items*.md

# Claude local env reference — env var names and URLs only, not credential values
CLAUDE.local.md

# Finder / tooling orphans that appear in any working tree
.DS_Store
docs/.DS_Store
.v2c/
.video_agent/

# A plan's generated graph, beside the plan document it executes — the
# execution record, rebuilt from the declaration whenever the plan
# changes. The plan is git-tracked; its runtime state is not.
docs/plans/*.graph.json

# Scratch and harness-side noise, never repo content: tmp/ holds the vm
# harnesses, screenshots and one-off scripts a session verifies with
# (the harness lives in tmp/ and is never committed), and .zcode/ is the
# harness's own plan store for a session, not fleet's.
/tmp/
/.zcode/
